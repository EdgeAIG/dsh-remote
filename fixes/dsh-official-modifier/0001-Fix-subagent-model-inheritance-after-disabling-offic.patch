+ /**
+- * Resolve the child's `AgentOptions`: the parent's provider/model/maxTokens
++ * Resolve the child's `AgentOptions`: the parent's live provider/model/maxTokens
+  * route unless the request overrides it, stamped with the child's own
+  * delegation depth.
++ *
++ * The live route comes from the parent session's latest request header — the
++ * route the parent actually used for its last completed request. Creation-time
++ * `parent.options` only carry the entry point default, which can diverge from
++ * the session-specific model selection a caller switched in the Web UI. Using
++ * the live header keeps a child (and therefore a whole subagent delegation)
++ * on the provider the parent user selected instead of falling back to a
++ * disabled deployment default.
+  * @param parent - the delegating parent whose route the child inherits.
+  * @param requested - per-child overrides, if any.
+  * @param childDepth - the resolved delegation depth to stamp.
+@@ -70,9 +78,10 @@ export function resolveChildAgentOptions(
+   requested: AgentOptions | undefined,
+   childDepth: number,
+ ): AgentOptions {
+-  const parentProvider = parent.options.provider
+-  const parentModel = parent.options.model
+-  const parentMaxTokens = parent.options.maxTokens
++  const liveRoute = parent.session.requestHeader()?.config
++  const parentProvider = liveRoute?.provider ?? parent.options.provider
++  const parentModel = liveRoute?.model ?? parent.options.model
++  const parentMaxTokens = liveRoute?.maxTokens ?? parent.options.maxTokens
+   return {
+     ...parentProvider !== undefined ? { provider: parentProvider } : {},
+     ...parentModel !== undefined ? { model: parentModel } : {},
