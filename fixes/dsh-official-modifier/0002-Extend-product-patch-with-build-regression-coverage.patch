+diff --git a/packages/subagent/subagent/tests/child-agent-route.spec.ts b/packages/subagent/subagent/tests/child-agent-route.spec.ts
+new file mode 100644
+index 0000000000000000000000000000000000000000..c5d4be26180eb561e185a937bfb0f9301047d1a5
+--- /dev/null
++++ b/packages/subagent/subagent/tests/child-agent-route.spec.ts
+@@ -0,0 +1,45 @@
++/**
++ * Focused pin for the subagent model-route inheritance fix:
++ * `resolveChildAgentOptions` must prefer the parent session's live request
++ * header (the route the parent actually used) over the creation-time
++ * `parent.options` that may carry a stale deployment default.
++ */
++
++import { describe, expect, it } from 'vitest'
++import { resolveChildAgentOptions } from '../src/child-agent.ts'
++import type { Agent } from '@deepseek-ai/dsh-agent'
++
++type Parent = Pick<Agent, 'options'> & { session: { requestHeader: () => { config: { provider: string; model: string; maxTokens?: number } } | undefined } }
++
++function makeParent(options: Agent['options'], header?: { provider: string; model: string; maxTokens?: number }): Parent {
++  return {
++    options: options ?? { provider: 'deepseek-official', model: 'deepseek-v4-flash' },
++    session: { requestHeader: () => header === undefined ? undefined : { config: header } },
++  }
++}
++
++describe('resolveChildAgentOptions live-route inheritance', () => {
++  it('prefers the parent session live route over creation-time options', () => {
++    const parent = makeParent(
++      { provider: 'deepseek-official', model: 'deepseek-v4-flash' },
++      { provider: 'deepseek', model: 'deepseek-v4-pro', maxTokens: 777 },
++    )
++    const resolved = resolveChildAgentOptions(parent, undefined, 2)
++    expect(resolved).toEqual({ provider: 'deepseek', model: 'deepseek-v4-pro', maxTokens: 777, subagentDepth: 2 })
++  })
++
++  it('falls back to creation-time options when the session has no request header', () => {
++    const parent = makeParent({ provider: 'deepseek', model: 'deepseek-v4-flash' }, undefined)
++    const resolved = resolveChildAgentOptions(parent, undefined, 1)
++    expect(resolved).toEqual({ provider: 'deepseek', model: 'deepseek-v4-flash', subagentDepth: 1 })
++  })
++
++  it('lets per-child overrides win over the inherited live route', () => {
++    const parent = makeParent(
++      { provider: 'deepseek-official', model: 'deepseek-v4-flash' },
++      { provider: 'deepseek', model: 'deepseek-v4-pro' },
++    )
++    const resolved = resolveChildAgentOptions(parent, { provider: 'opencode', model: 'big-pickle' }, 3)
++    expect(resolved).toEqual({ provider: 'opencode', model: 'big-pickle', subagentDepth: 3 })
++  })
++})
