index 0000000..c818ffb
--- /dev/null
+++ b/tools/enable-opencode-zen.mjs
@@ -0,0 +1,92 @@
+#!/usr/bin/env node
+/**
+ * Wire the DSH OpenCode Zen bridge into a checkout produced by install.sh.
+ *
+ * This mutates the workspace manifests and the active base web composition so
+ * that the standalone `@deepseek-ai/dsh-llm-opencode` adapter and the anonymous
+ * Exa MCP web-search plugin are recognized, type-checked, and mounted. It is
+ * idempotent: running it on a checkout that already has the bridge enabled is a
+ * no-op for every change it already applied.
+ */
+
+import { readFileSync, writeFileSync, mkdirSync } from 'node:fs'
+import { join } from 'node:path'
+
+const root = process.argv[2]
+if (!root) throw new Error('usage: node tools/enable-opencode-zen.mjs <harness-checkout>')
+
+function readJson(path) {
+  return JSON.parse(readFileSync(path, 'utf8'))
+}
+function writeJson(path, value) {
+  writeFileSync(path, JSON.stringify(value, null, 2) + '\n')
+}
+function addWorkspaceDep(manifestPath, name) {
+  const manifest = readJson(manifestPath)
+  const deps = manifest.dependencies ?? {}
+  if (!(name in deps)) deps[name] = 'workspace:^'
+  manifest.dependencies = Object.fromEntries(Object.entries(deps).sort(([a], [b]) => a.localeCompare(b)))
+  writeJson(manifestPath, manifest)
+}
+function addTsReference(tsconfigPath, ref) {
+  if (!ref.startsWith('./')) ref = './' + ref
+  let text = readFileSync(tsconfigPath, 'utf8')
+  if (text.includes(ref)) return
+  const needle = '    { "path": "./packages/llm/llm-pi-ai" }'
+  if (ref.includes('/llm/llm-opencode') && text.includes(needle)) {
+    text = text.replace(needle, needle + ',\n    { "path": ' + JSON.stringify(ref) + ' }', 1)
+  } else {
+    const exaNeedle = '    { "path": "./packages/web/web-search-exa" }'
+    text = text.replace(exaNeedle, exaNeedle + ',\n    { "path": ' + JSON.stringify(ref) + ' }', 1)
+  }
+  writeFileSync(tsconfigPath, text)
+}
+
+const basePkg = join(root, 'packages/bundle/base/package.json')
+const webAppPkg = join(root, 'packages/bundle/web-app/package.json')
+addWorkspaceDep(basePkg, '@deepseek-ai/dsh-llm-opencode')
+addWorkspaceDep(webAppPkg, '@deepseek-ai/dsh-web-search-exa-mcp')
+
+const tsconfigHost = join(root, 'tsconfig.host.json')
+addTsReference(tsconfigHost, './packages/llm/llm-opencode')
+addTsReference(tsconfigHost, './packages/web/web-search-exa-mcp')
+
+const baseCordis = join(root, 'packages/bundle/base/cordis.patch.yml')
+let base = readFileSync(baseCordis, 'utf8')
+
+// Default agent model -> the bridge route.
+base = base
+  .replace('provider: deepseek\n        model: deepseek-v4-flash', 'provider: opencode-zen\n        model: big-pickle')
+  .replace('provider: deepseek\n        model: deepseek-v4-flash', 'provider: opencode-zen\n        model: big-pickle')
+
+// Mount the standalone adapter and the web-search plugin rows.
+if (!base.includes('id: llm-opencode')) {
+  const anchor = '    - id: llm-pi-ai\n      name: \'@deepseek-ai/dsh-llm-pi-ai\'\n'
+  const rows = anchor + `
+    # OpenCode Zen bridge: local shim-backed free-model adapter (DHS-M/dsh-opencode-zen).
+    - id: llm-opencode
+      name: '@deepseek-ai/dsh-llm-opencode'
+      config:
+        baseURL: http://127.0.0.1:8791/v1
+        autoDiscover: true
+        freeOnly: true
+        models:
+          - id: big-pickle
+            name: Big Pickle
+            contextWindow: 200000
+            maxTokens: 32000
+`
+  base = base.replace(anchor, rows, 1)
+}
+if (!base.includes('id: web-search-exa-mcp')) {
+  const webAnchor = '      name: \'@deepseek-ai/dsh-web\'\n'
+  const row = `      name: '@deepseek-ai/dsh-web'\n\n    - id: web-search-exa-mcp\n      name: '@deepseek-ai/dsh-web-search-exa-mcp'\n      config:\n        endpoint: https://mcp.exa.ai/mcp\n        tool: web_search_exa\n`
+  base = base.replace(webAnchor, row, 1)
+}
+writeFileSync(baseCordis, base)
+
+// Make sure the package directories exist (install.sh already copies them).
+mkdirSync(join(root, 'packages/llm/llm-opencode'), { recursive: true })
+mkdirSync(join(root, 'packages/web/web-search-exa-mcp'), { recursive: true })
+
+console.log('Enabled DSH OpenCode Zen bridge in', root)
