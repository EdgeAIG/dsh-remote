diff --git a/tools/enable-opencode-zen.mjs b/tools/enable-opencode-zen.mjs
index bfcb701..6392160 100644
--- a/tools/enable-opencode-zen.mjs
+++ b/tools/enable-opencode-zen.mjs
@@ -61,11 +61,11 @@ base = base
 if (!base.includes('id: llm-opencode')) {
   const anchor = '    - id: llm-pi-ai\n      name: \'@deepseek-ai/dsh-llm-pi-ai\'\n'
   const rows = anchor + `
-    # OpenCode Zen bridge: local shim-backed free-model adapter (DHS-M/dsh-opencode-zen).
+    # OpenCode Zen bridge: direct anonymous free-model adapter (DHS-M/dsh-opencode-zen).
     - id: llm-opencode
       name: '@deepseek-ai/dsh-llm-opencode'
       config:
-        baseURL: http://127.0.0.1:8791/v1
+        baseURL: https://opencode.ai/zen/v1
         autoDiscover: true
         freeOnly: true
         models:
@@ -85,14 +85,27 @@ mkdirSync(join(root, 'packages/llm/llm-opencode'), { recursive: true })
 // chunks (`state.name += raw.function.name`), so a normal one-chunk tool name
 // becomes `web_searchweb_search` and every call fails as an unknown tool. The
 // adapter must overwrite the name, matching the DeepSeek translation path.
+// It also ships with a loopback-shim default, so point the adapter directly at
+// OpenCode Zen's anonymous route and include the failing URL in transport
+// errors instead of a vague "request failed".
 const adapterDir = join(root, 'packages/llm/llm-opencode')
 for (const rel of ['src/index.ts', 'lib/index.js']) {
   const file = join(adapterDir, rel)
   if (!existsSync(file)) continue
   const text = readFileSync(file, 'utf8')
-  const updated = text
+  let updated = text
     .replace('state.name += raw.function.name', 'state.name = raw.function.name')
     .replace('state.name += raw.function.name;', 'state.name = raw.function.name;')
+    // Direct anonymous OpenCode Zen route.
+    updated = updated
+      .replace('DEFAULT_SHIM_BASE_URL = \'http://127.0.0.1:8791/v1\'', 'DEFAULT_BASE_URL = \'https://opencode.ai/zen/v1\'')
+      .replace('DEFAULT_SHIM_BASE_URL', 'DEFAULT_BASE_URL')
+    // Surface the actual endpoint in transport failures.
+    updated = updated
+      .replace('throw new LlmError(\'OpenCode Zen request failed\', \'TRANSPORT\', { cause: error })',
+               'throw new LlmError(`OpenCode Zen request failed for ${completionURL(config.baseURL)}`, \'TRANSPORT\', { cause: error })')
+      .replace('throw new LlmError("OpenCode Zen request failed", "TRANSPORT", { cause: error })',
+               'throw new LlmError(`OpenCode Zen request failed for ${completionURL(config.baseURL)}`, "TRANSPORT", { cause: error })')
   if (updated !== text) writeFileSync(file, updated)
 }
 
